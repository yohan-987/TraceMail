      </div>
      <div className={cn('text-[13px] truncate', mono ? 'mono' : '', valueClassName ?? (danger ? 'text-accent-300' : 'text-ink-200'))}>
        {value}
      </div>
      {note && <div className="text-[10px] text-ink-600 mt-1">{note}</div>}
    </div>
