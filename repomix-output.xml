    body: "Click here to verify your account and enter your password.",
    urlCount: 1,
    urgency: 2,
    credentialRequest: 1,
    financialRequest: 0,
  });
  const pHam = predictPhishingProbability(model, {
    subject: "Weekly digest",
    body: "Here is your weekly digest of company news and updates.",
    urlCount: 0,
    urgency: 0,
    credentialRequest: 0,
    financialRequest: 0,
