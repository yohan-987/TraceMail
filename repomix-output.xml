      ) : (
        <div className="flex items-center gap-2 text-[12px] text-emerald-400 mb-5">
          <CheckCircle className="w-3.5 h-3.5" /> No sender anomalies
        </div>
      )}

      <PreviewInvestigateButton label="Open Full Forensics" onClick={onInvestigate} />
    </div>
  );
}
