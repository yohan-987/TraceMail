  };
  const infrastructure: InfrastructureAssessment = overrides.infrastructure ?? {
    emailId,
    candidateIp: "198.51.100.23",
    country: "US",
    region: "VA",
    city: "Ashburn",
    isp: "DigitalOcean",
    asn: "AS14061",
    confidence: 0.5,
    status: "AVAILABLE",
    ipIntelligence: [geo],
    domainIntelligence: [
      {
        domain: "evil.example",
