      `To: ${fields.to}`,
      `Subject: ${fields.subject}`,
      "",
      fields.body,
      "",
    ].join("\r\n"),
    "utf-8"
  );
}

async function scan(fields: { from: string; to: string; subject: string; body: string }, filename: string) {
  const res = await request(app).post("/api/v1/emails/scan").attach("file", eml(fields), filename);
