+function formatFraction(value: unknown): string {
+  if (typeof value !== 'number' || !Number.isFinite(value)) {
+    return 'UNAVAILABLE';
+  }
+
+  return `${Math.round(Math.max(0, Math.min(1, value)) * 100)}%`;
+}
