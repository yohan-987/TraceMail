+/*
+ * Leaflet overrides — themed to match the app's dark/light palette
+ * instead of Leaflet's default white popup/control chrome. Kept
+ * outside @layer so these plain-CSS-selector rules reliably beat
+ * Leaflet's own stylesheet regardless of import order.
+ */
+.leaflet-container {
+  font-family: 'Inter', 'Segoe UI', system-ui, sans-serif;
+  background: rgb(var(--base-950));
+}
+
+.leaflet-popup-content-wrapper {
+  background: rgb(var(--base-800));
+  color: rgb(var(--ink-100));
+  border: 1px solid rgb(var(--base-500) / 0.4);
+  border-radius: 10px;
+  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
+}
+
+.leaflet-popup-tip {
+  background: rgb(var(--base-800));
+  border: 1px solid rgb(var(--base-500) / 0.4);
+}
+
+.leaflet-popup-close-button {
+  color: rgb(var(--ink-400)) !important;
+}
+
+.leaflet-control-zoom a {
+  background: rgb(var(--base-800)) !important;
+  color: rgb(var(--ink-200)) !important;
+  border-color: rgb(var(--base-500) / 0.4) !important;
+}
+
+.leaflet-control-zoom a:hover {
+  background: rgb(var(--base-700)) !important;
+}
+
+.leaflet-control-attribution {
+  background: rgb(var(--base-900) / 0.85) !important;
+  color: rgb(var(--ink-600)) !important;
+}
+
+.leaflet-control-attribution a {
+  color: rgb(var(--ink-400)) !important;
+}
