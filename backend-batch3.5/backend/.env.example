PORT=4000
NODE_ENV=development

# Optional comma-separated browser origins. Unset = reflect any Origin
# (correct for local frontend development). Do not put a production
# domain here by default.
# CORS_ORIGINS=http://localhost:5173

# Frontend: this API listens on PORT (4000). Vite is usually :5173.
# Either rely on CORS above, or proxy in vite.config.ts:
#   server: { proxy: { "/api": "http://localhost:4000" } }

# Batch 4 — never expose this to the frontend
# LLM_PROVIDER selects the wire format: "anthropic" (default) or "gemini".
# Leave LLM_API_KEY empty to keep AI assessment UNAVAILABLE (safe default).
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_API_URL=https://api.anthropic.com/v1/messages
LLM_MODEL=claude-haiku-4-5-20251001
LLM_TIMEOUT_MS=15000

# To use Gemini instead:
#   LLM_PROVIDER=gemini
#   LLM_API_KEY=<your Gemini API key>
#   LLM_MODEL=<a current Gemini model name, e.g. gemini-2.5-flash>
#   LLM_API_URL is optional for Gemini — only set it to override the
#   default https://generativelanguage.googleapis.com/v1beta/models base

# Batch 4 — GeoIP provider (unset = UNAVAILABLE, scan still succeeds)
GEOIP_API_URL=http://ip-api.com/json
GEOIP_TIMEOUT_MS=5000

# Batch 4 — DNS intelligence (set to 0 to disable)
DNS_INTEL_ENABLED=1
DNS_TIMEOUT_MS=2000

# Batch 4 — optional override; leave blank to use the bundled
# models/tfidf-logistic-v1.json (a blank value here is correctly treated
# as "unset", not as an empty path)
ML_MODEL_PATH=

# Upload limits (Batch 1; ~25MB default since Batch 7)
MAX_UPLOAD_BYTES=26214400
