@@ -0,0 +1,144 @@
+import "dotenv/config";
+import { buildLlmUserPayload } from "../analyzers/aiAssessment";
+import { llmProviderFromEnv } from "../services/llmClient";
+import type {
+  AuthenticationAnalysis,
+  HeaderAnalysis,
+  MLAssessment,
+  ParsedEmail,
+  URLAnalysis,
+} from "../schemas/types";
+
+// MANUAL, TEMPORARY diagnostic — not run by `npm test`, not wired into
+// any route. Run by hand with a real .env configured:
+//
+//   npx tsx src/scripts/geminiTimingDiagnostic.ts
+//
+// Compares the SAME provider code (llmProviderFromEnv() ->
+// LlmProvider.complete(), unchanged interface) against two payload
+// sizes: a two-word prompt (mirrors the user's known-working direct
+// test) and a synthetic "realistic" prompt built the same way
+// buildLlmUserPayload() builds the real one — using placeholder Latin
+// filler text, NEVER a real email — so the two runs are an apples-to-
+// apples comparison through the app's actual code path.
+//
+// Prints only sizes and elapsed milliseconds. Never prints the API
+// key, the prompt text, or the raw response text.
+
+const SYSTEM_PROMPT_FOR_TINY_TEST = "Reply with exactly: {\"ok\":true}";
+
+// Deliberately synthetic — not a real email, not real evidence. Sized
+// to resemble a realistic scan payload (subject + ~4000 char body +
+// several header/URL/domain entries), matching buildLlmUserPayload's
+// own truncation limits so the comparison is representative.
+function syntheticRealisticPayload(): string {
+  const fillerSentence =
+    "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore. ";
+  const bodyText = fillerSentence.repeat(45); // ~4300 chars before truncation to 4000
+
+  const parsed: ParsedEmail = {
+    emailId: "DIAGNOSTIC-ONLY",
+    subject: "Diagnostic placeholder subject line for timing comparison",
+    from: [{ displayName: "Example Sender", email: "sender@example.test", localPart: "sender", domain: "example.test" }],
+    to: [{ displayName: null, email: "recipient@example.test", localPart: "recipient", domain: "example.test" }],
+    cc: [],
+    bcc: [],
+    replyTo: [{ displayName: null, email: "reply@example.test", localPart: "reply", domain: "example.test" }],
+    returnPath: [],
+    date: new Date().toISOString(),
+    messageId: "<diagnostic-only@example.test>",
+    headers: { normalized: {}, raw: [] },
+    body: { text: bodyText, html: null },
+    attachments: [],
+  };
+
+  const headerAnalysis: HeaderAnalysis = {
+    emailId: "DIAGNOSTIC-ONLY",
+    anomalies: Array.from({ length: 12 }, (_, i) => ({
+      type: `diagnostic_anomaly_${i}`,
+      severity: "medium" as const,
+      message: `Placeholder anomaly message ${i} for timing diagnostic only.`,
+      evidence: {},
+      weight: 5,
+      category: "technical" as const,
+      provenance: "DETERMINISTIC_ANALYSIS" as const,
+    })),
+    receivedChain: [],
+    status: "VERIFIED",
+  };
+
+  const authentication: AuthenticationAnalysis = {
+    emailId: "DIAGNOSTIC-ONLY",
+    spf: { result: "fail", raw: "v=spf1 -all" },
+    dkim: { result: "fail", raw: null },
+    dmarc: { result: "fail", policy: "reject", raw: "p=reject" },
+  };
+
+  const urlAnalysis: URLAnalysis = {
+    emailId: "DIAGNOSTIC-ONLY",
+    urls: Array.from({ length: 10 }, (_, i) => ({
+      url: `https://diagnostic-${i}.example.test/path`,
+      hostname: `diagnostic-${i}.example.test`,
+      domain: `diagnostic-${i}.example.test`,
+      isHttps: true,
+      urlLength: 40,
+      subdomainLength: 0,
+      pathLength: 5,
+      queryLength: 0,
+      hasIpHost: false,
+      hasAtSymbol: false,
+      hasEncodedCharacters: false,
+      hasMultipleSubdomains: false,
+      isShortened: false,
+      riskNotes: [],
+    })),
+  };
+
+  const mlAssessment: MLAssessment = {
+    emailId: "DIAGNOSTIC-ONLY",
+    model: "tfidf-logistic-v1",
+    modelVersion: "1.0.0",
+    classification: "phishing",
+    probability: 0.5,
+    status: "AVAILABLE",
+  };
+
+  return buildLlmUserPayload({ parsed, headerAnalysis, authentication, urlAnalysis, mlAssessment });
+}
+
+async function runOne(label: string, system: string, user: string): Promise<void> {
+  const provider = llmProviderFromEnv();
+  if (!provider) {
+    console.log(`[${label}] provider is null — check LLM_PROVIDER/LLM_API_KEY/LLM_MODEL in .env`);
+    return;
+  }
+
+  const bodyBytes = Buffer.byteLength(system, "utf-8") + Buffer.byteLength(user, "utf-8");
+  console.log(`\n=== ${label} === (approx system+user bytes: ${bodyBytes})`);
+  const start = Date.now();
+  try {
+    const result = await provider.complete({ system, user });
+    console.log(
+      `[${label}] SUCCESS | elapsed: ${Date.now() - start}ms | response length: ${result.length} chars`
+    );
+  } catch (err) {
+    console.log(
+      `[${label}] FAILED | elapsed: ${Date.now() - start}ms | ${err instanceof Error ? err.constructor.name + ": " + err.message : String(err)}`
+    );
+  }
+}
+
+async function main() {
+  console.log("Gemini timing diagnostic — compares the app's real provider code with two prompt sizes.");
+  console.log("(The [ai-debug] lines interleaved below come from llmClient.ts/aiAssessment.ts itself.)");
+
+  await runOne("tiny prompt", SYSTEM_PROMPT_FOR_TINY_TEST, "");
+  await runOne("realistic-size synthetic prompt", "You are a phishing-analysis assistant. Reply with a small JSON object.", syntheticRealisticPayload());
+
+  console.log("\nCompare the two 'elapsed' values above against your native-fetch baseline.");
+}
+
+main().catch((err) => {
+  console.error("Diagnostic script failed:", err instanceof Error ? err.message : String(err));
+  process.exitCode = 1;
+});
